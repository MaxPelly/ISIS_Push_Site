# Copy to push_site.ini and edit. Relative paths are relative to this file.

[SERVER]
# The public listener, for a reverse proxy (e.g. Caddy) that terminates HTTPS in
# front. Bind to localhost, or if the proxy runs in a container, to the address
# the container reaches the host on (e.g. the Docker bridge's gateway).
# host = 127.0.0.1
# port = 8765
# The monitor's ingest socket: /ingest and /ingest/status are only answered here.
# The site makes it read-writable by its group (in the README's setup, isis-ingest,
# which the monitor's user is in).
# ingest_socket = ingest.sock
# The public HTTPS origin phones load the site from (required).
public_origin = https://push.example.org

[SECRETS]
# The secret the monitor signs with (32 to 4096 characters, e.g. `openssl rand
# -hex 32`; surrounding whitespace is ignored). Left unset, the site reads
# systemd's ingest-secret credential (LoadCredential=ingest-secret:<file> in its
# unit), as the README's setup does; only `serve` needs it.
# ingest_secret_file = push.secret
# The site's VAPID private key, created by `python -m push_site vapid push_site.ini`.
# vapid_key_file = vapid.pem
# A contact address for push services (Apple, Google, Mozilla) to reach the admin.
vapid_subject = mailto:admin@example.org

[STORAGE]
# In its own directory, the only one the systemd unit lets the site write to.
db_path = data/push_site.db
# The feed keeps this many recent notifications of each kind (beam, MCR news,
# daily summaries and experiments; 10 to 1000), none older than feed_max_days.
# feed_items_per_kind = 75
# feed_max_days = 30
