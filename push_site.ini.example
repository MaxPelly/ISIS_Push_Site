# Copy to push_site.ini and edit. Relative paths are relative to this file.

[SERVER]
# Bind to localhost only; a reverse proxy (e.g. Caddy) terminates HTTPS in front.
# Use 0.0.0.0 if the proxy runs in a container (/ingest still only answers loopback).
# host = 127.0.0.1
# port = 8765
# The public HTTPS origin phones load the site from (required).
public_origin = https://push.example.org

[SECRETS]
# The same secret as the monitor's [PUSH] secret_file (at least 32 characters,
# e.g. `openssl rand -hex 32`; surrounding whitespace is ignored). Keep it chmod 600,
# readable by the site's user through an ACL (see the README).
ingest_secret_file = push.secret
# The site's VAPID private key, created by `python -m push_site vapid push_site.ini`.
# vapid_key_file = vapid.pem
# A contact address for push services (Apple, Google, Mozilla) to reach the admin.
vapid_subject = mailto:admin@example.org

[STORAGE]
# In its own directory, the only one the systemd unit lets the site write to.
db_path = data/push_site.db
# The feed keeps this many recent notifications of each kind (beam, MCR news,
# daily summaries and experiments; 10 to 1000), none older than feed_max_days.
# feed_items_per_kind = 75
# feed_max_days = 30
