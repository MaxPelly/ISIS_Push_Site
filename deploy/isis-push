#!/bin/sh
# The site's admin commands, run as the site's user from any directory and any
# account that may sudo to it (root, a sudoer, or see deploy/isis-push.sudoers):
#   isis-push invite --label "Alex's phone" [--uses N] [--days D]
#   isis-push devices
#   isis-push revoke ID
#   isis-push vapid            (once, before the site first starts)
# For the README's layout as is; install it at /usr/local/bin/isis-push, the
# path the sudoers rule names, owned by root and not writable by anyone else:
#   sudo install -m 755 deploy/isis-push /usr/local/bin/isis-push
set -eu
site=/opt/isis-push-site
config=/etc/isis-push-site/push_site.ini
user=isis-push

case "${1:-}" in
    invite|devices|revoke|vapid) ;;
    *) echo "usage: isis-push invite|devices|revoke|vapid ... (add --help for a command's options)" >&2; exit 2 ;;
esac

if [ "$(id -un)" != "$user" ]; then
    exec sudo -u "$user" -- "$0" "$@"
fi
# python -m imports from the working directory, so run it from the site's own.
cd "$site"
command=$1
shift
exec "$site/.venv/bin/python" -m push_site "$command" "$config" "$@"
