# Example Caddy site behind Cloudflare's proxy (a proxied DNS record, with
# Cloudflare's SSL mode set to "Full (strict)"). The monitor posts to /ingest
# over the site's Unix socket; the listener proxied here doesn't have it, and
# Caddy refuses it too.
push.example.org {
	# A Cloudflare Origin Certificate (SSL/TLS > Origin Server), readable by
	# the caddy user: Caddy's HTTP and TLS-ALPN challenges can't get through
	# the proxy. Or delete this line and use Let's Encrypt's DNS challenge
	# (a Caddy build with the Cloudflare DNS module and, in the global
	# options, `acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}`), which also
	# works without Cloudflare's proxy.
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key

	@ingest path /ingest /ingest/*
	respond @ingest 404

	request_body {
		max_size 64KiB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip
	# For Caddy in Docker: the Docker bridge's gateway, e.g. 172.17.0.1:8765
	# (`docker network inspect bridge`), with the site's host set to it.
	reverse_proxy 127.0.0.1:8765

	# Rate limiting is best done with a Cloudflare rate limiting rule on
	# /api/*: behind the proxy, Caddy sees Cloudflare's addresses, not the
	# phones'.
}
