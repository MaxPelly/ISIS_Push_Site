# Example Caddy site behind Cloudflare's proxy (a proxied DNS record, with
# Cloudflare's SSL mode set to "Full (strict)"). The monitor daemon posts to
# /ingest directly on 127.0.0.1:8765, so that path is never served publicly.
push.example.org {
	# A Cloudflare Origin Certificate (SSL/TLS > Origin Server), readable by
	# the caddy user. Caddy's own Let's Encrypt challenges can't get through
	# the proxy. Without Cloudflare, delete this line and Caddy gets a
	# certificate itself.
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key

	@ingest path /ingest /ingest/*
	respond @ingest 404

	request_body {
		max_size 64KiB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip
	reverse_proxy 127.0.0.1:8765

	# Rate limiting is best done with a Cloudflare rate limiting rule on
	# /api/*: behind the proxy, Caddy sees Cloudflare's addresses, not the
	# phones'.
}
