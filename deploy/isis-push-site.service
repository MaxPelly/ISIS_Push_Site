# ISIS push notification site, run from the monitor's push_site submodule as
# its own user, isis-push, so a compromise can't act as the monitor's user.
# ACLs give it read-only access to the code, config, secret and VAPID key, and
# its database is in data/, owned by it (see the README's setup steps).
# EDIT before installing: /path/to/ISIS_Beam_Monitor is the monitor's checkout.
#   sed "s|/path/to/ISIS_Beam_Monitor|$MONITOR_DIR|g" deploy/isis-push-site.service \
#     | sudo tee /etc/systemd/system/isis-push-site.service
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now isis-push-site
# Logs:    journalctl -u isis-push-site

[Unit]
Description=ISIS Beam Monitor push notification site
After=network-online.target
Wants=network-online.target
# Never give up restarting (a start limit could leave it down for good after a
# brief outage); RestartSteps backs off from 5s to 5min instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=isis-push
Group=isis-push
WorkingDirectory=/path/to/ISIS_Beam_Monitor/push_site
ExecStart=/path/to/ISIS_Beam_Monitor/push_site/.venv/bin/python -m push_site serve /path/to/ISIS_Beam_Monitor/push_site/push_site.ini
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=5min
UMask=0077
MemoryMax=256M

# Sandboxing: it can't see the rest of /home, can't change its own code or
# secrets, and can only write its database in data/. It needs only inbound
# connections (from Caddy and the daemon) and outbound HTTPS to push services.
# If the venv is outside the site's directory, add it to BindReadOnlyPaths.
# data/ must exist before the unit starts, owned by isis-push, with db_path
# set to data/push_site.db in push_site.ini.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/path/to/ISIS_Beam_Monitor/push_site
BindPaths=/path/to/ISIS_Beam_Monitor/push_site/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
