# ISIS push notification site, run as claude from the monitor's push_site
# submodule. Its config (push_site.ini), secret, VAPID key and database all
# live in that directory (all gitignored).
# Install: sudo cp isis-push-site.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now isis-push-site
# Logs:    journalctl -u isis-push-site

[Unit]
Description=ISIS Beam Monitor push notification site
After=network-online.target
Wants=network-online.target
# Give up if it fails to start 5 times in a minute (e.g. a config error).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/home/claude/ISIS_Beam_Monitor/push_site
ExecStart=/home/claude/ISIS_Beam_Monitor/push_site/.venv/bin/python -m push_site serve /home/claude/ISIS_Beam_Monitor/push_site/push_site.ini
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
UMask=0077

# Sandboxing: it only writes its database in its own directory, and only
# needs localhost (from Caddy and the daemon) and outbound HTTPS to push services.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/claude/ISIS_Beam_Monitor/push_site
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
