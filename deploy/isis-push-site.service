# ISIS push notification site, as its own user, isis-push, from a root-owned
# checkout it can't change (see the README's setup steps):
#   /opt/isis-push-site                    the code, with its venv in .venv
#   /etc/isis-push-site/push_site.ini      the config
#   /etc/isis-push-site/ingest.secret      the secret the monitor signs with
#                                          (root's, 0600; given to the site as a credential)
#   /var/lib/isis-push-site                its database and VAPID key (StateDirectory)
#   /run/isis-push-site/ingest.sock        the monitor's ingest socket (RuntimeDirectory),
#                                          reachable by the isis-ingest group
# Install: sudo install -m 644 deploy/isis-push-site.service /etc/systemd/system/
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now isis-push-site
# Logs:    journalctl -u isis-push-site

[Unit]
Description=ISIS Beam Monitor push notification site
After=network-online.target
Wants=network-online.target
# Never give up restarting (a start limit could leave it down for good after a
# brief outage); RestartSteps backs off from 5s to 5min instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=isis-push
# The ingest socket and its directory take this group; the monitor's user is in it.
Group=isis-ingest
WorkingDirectory=/opt/isis-push-site
ExecStart=/opt/isis-push-site/.venv/bin/python -m push_site serve /etc/isis-push-site/push_site.ini
Environment=PYTHONUNBUFFERED=1
LoadCredential=ingest-secret:/etc/isis-push-site/ingest.secret
StateDirectory=isis-push-site
StateDirectoryMode=0700
RuntimeDirectory=isis-push-site
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=5min
UMask=0077
MemoryMax=256M

# Sandboxing: it can write only its state and runtime directories, and needs
# only inbound connections (from the reverse proxy and the monitor's socket)
# and outbound HTTPS to push services.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
